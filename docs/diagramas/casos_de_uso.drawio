        <mxCell id="leyenda" value="&lt;b&gt;Equivalencias con el Donkey Kong original&lt;/b&gt;&lt;br&gt;&lt;b&gt;Jugador&lt;/b&gt; → Mario&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;Chiqui (antagonista)&lt;/b&gt; → Donkey Kong&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;Pelotas&lt;/b&gt; → Barriles&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;Copa (Torneo Apertura)&lt;/b&gt; → Pauline / meta&lt;br&gt;&lt;br&gt;Línea continua: asociación actor–caso de uso&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#1F5FA8&quot;&gt;«include»: el caso base siempre ejecuta al incluido&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#B0122B&quot;&gt;«extend» [condición]: comportamiento opcional&lt;/font&gt;&lt;br&gt;&lt;i&gt;Chiqui es un actor no humano (controlado por el sistema): dispara CU05 de forma periódica según el temporizador del juego.&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=13;fillColor=#FFFDF5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1520" height="140" as="geometry"/></mxCell>
